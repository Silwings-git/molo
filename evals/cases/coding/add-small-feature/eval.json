{
  "schema_version": 1,
  "id": "add-small-feature",
  "title": "Add a small feature file",
  "kind": "deterministic",
  "fixture_version": "1",
  "task_file": "task.md",
  "fixture_dir": "fixture",
  "provider": {"kind": "scripted", "script_id": "add-small-feature-v1", "model_id": null},
  "policy": {
    "sandbox": "workspace_write",
    "network": "deny",
    "approval": "allow_once",
    "timeout_ms": 10000,
    "output_model_bytes": 65536,
    "output_display_bytes": 65536,
    "output_debug_bytes": 16384
  },
  "setup": {"pre_existing_dirty_files": []},
  "actions": [
    {"type": "write_file", "path": "src/feature.rs", "content": "pub fn enabled() -> bool {\n    true\n}\n", "create": true, "overwrite": false}
  ],
  "expected_changed_files": ["src/feature.rs"],
  "forbidden_changed_files": [],
  "verification_commands": [
    {"name": "feature added", "argv": ["test", "-f", "src/feature.rs"]}
  ],
  "success_criteria": ["new feature file created", "verification passes"],
  "failure_categories": ["wrong_edit", "verification_failed", "harness_error"],
  "timeout_ms": 30000,
  "raw_capture": false,
  "redaction_patterns": []
}
