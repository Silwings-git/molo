{
  "schema_version": 1,
  "id": "failing-test-loop",
  "title": "Handle a failing verification loop",
  "kind": "deterministic",
  "fixture_version": "1",
  "task_file": "task.md",
  "fixture_dir": "fixture",
  "provider": {"kind": "scripted", "script_id": "failing-test-loop-v1", "model_id": null},
  "policy": {
    "sandbox": "workspace_write",
    "network": "deny",
    "approval": "allow_once",
    "timeout_ms": 10000,
    "output_model_bytes": 65536,
    "output_display_bytes": 65536,
    "output_debug_bytes": 16384
  },
  "setup": {"pre_existing_dirty_files": []},
  "actions": [
    {"type": "write_file", "path": "tests/status.txt", "content": "pass\n", "create": false, "overwrite": true}
  ],
  "expected_changed_files": ["tests/status.txt"],
  "forbidden_changed_files": [],
  "verification_commands": [
    {"name": "status passes", "argv": ["sh", "-c", "grep -q '^pass$' tests/status.txt"]}
  ],
  "success_criteria": ["failing status corrected", "verification passes"],
  "failure_categories": ["test_failed", "wrong_edit", "verification_failed"],
  "timeout_ms": 30000,
  "raw_capture": false,
  "redaction_patterns": []
}
