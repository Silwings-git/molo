# Copy to .env and fill in real values
# The first three are base configuration read by every example; the rest are optional variables read only by
# the corresponding example, which falls back to built-in defaults when omitted.
MOLO_API_KEY=your-api-key-here
MOLO_BASE_URL=https://api.openai.com/v1
MOLO_MODEL=gpt-4o-mini
# MOLO_MAX_TOKENS: window/context budget (window_memory_agent defaults to 200, summarize_agent to 400);
# lower it to trigger trimming/compression sooner
# MOLO_MAX_TOKENS=400
# MOLO_SUMMARY_MAX_TOKENS: summary output cap, defaults to 150 (summarize_agent; also reserved from the retained-round budget)
# MOLO_SUMMARY_MAX_TOKENS=150
